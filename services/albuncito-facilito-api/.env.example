# Secreto para firmar los JWT (obligatorio). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Archivo SQLite (opcional, por defecto data/albuncito.db)
DATABASE_PATH=data/albuncito.db
# Origen permitido por CORS (opcional, por defecto http://localhost:3000)
FRONTEND_URL=http://localhost:3000
